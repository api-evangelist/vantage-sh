        {
          "info": {
            "name": "Create Azure integration",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.vantage.sh/v2/integrations/azure",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://console.vantage.sh/account/profile",
              "credentials": {
                "clientId": "{{clientId}}",
